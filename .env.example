# ContentCreate — variáveis de ambiente
# Copie para `.env` e preencha só o que for usar. NUNCA commite o `.env`.
# Tudo aqui é lido apenas no servidor (validado em src/lib/env.ts) — nenhuma
# chave vai para o navegador.

# --- Banco (obrigatório) -----------------------------------------------------
# Postgres + pgvector via Docker (`npm run db:up`, ver docker-compose.yml).
# Estas credenciais são só do container local.
DATABASE_URL="postgresql://contentcreate:contentcreate@localhost:5439/contentcreate?schema=public"

NODE_ENV=development

# --- IA que escreve os posts -------------------------------------------------
# Regra: se LLM_API_KEY estiver preenchida, usa Anthropic (Claude Haiku 4.5).
# Se estiver vazia, usa o Ollama local (gratuito).
# LLM_API_KEY=

# Ollama — https://ollama.com. Rode `ollama serve` e baixe os modelos:
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
# OLLAMA_URL=http://localhost:11434
# Modelo de texto (default qwen2.5:7b, ~8 GB de VRAM).
#   Máquina sem GPU / mais fraca: qwen2.5:3b. Mais qualidade: qwen2.5:14b.
# OLLAMA_MODEL=qwen2.5:7b
# Modelo de embeddings — usado na deduplicação semântica e na Memória, mesmo
# quando o texto é gerado pela Anthropic (default nomic-embed-text).
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Timeout por chamada, em ms (default 120000).
# OLLAMA_TIMEOUT_MS=120000
# Janela de contexto em tokens (default 8192). Aumentar consome mais VRAM.
# OLLAMA_NUM_CTX=8192
# Tempo que o modelo fica carregado entre chamadas (default 10m).
# OLLAMA_KEEP_ALIVE=10m

# --- Coleta via API de notícias (opcional) -----------------------------------
# Só é usada se houver queries em config/sources.ts (newsApiQueries).
# Provedores suportados: newsapi.org, gnews.io, newsdata.io.
# NEWS_API_KEY=

# --- Exportação ---------------------------------------------------------------
# Pasta onde cada post aprovado é exportado (default ./output).
# PUBLISH_OUTPUT_DIR=./output

# --- Agendador e notificações (opcional) --------------------------------------
# Expressão cron do `npm run scheduler:start` (default "0 8 * * *" = 08:00).
# PIPELINE_CRON=0 8 * * *
# Telegram: com os DOIS preenchidos, avisa ao gerar rascunhos ou falhar.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
