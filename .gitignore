# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Segredos — NUNCA versionar. Só o .env.example (sem valores reais) entra.
# ---------------------------------------------------------------------------
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.secret
*secret*.json
credentials*.json
service-account*.json
.npmrc
/secrets/

# saída de amostras de render (inspeção visual local)
/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — client gerado (regenerável com `prisma generate`) e bancos locais
/src/generated/
*.db
*.db-journal
*.db.bak*
*.sql.gz
*.dump

# Pacotes exportados pela esteira (imagens + legendas geradas localmente)
/output/

# ---------------------------------------------------------------------------
# Material interno de trabalho — fica só na máquina de quem desenvolve
# ---------------------------------------------------------------------------
/docs/
/.obsidian/
/.vscode/
/.idea/
